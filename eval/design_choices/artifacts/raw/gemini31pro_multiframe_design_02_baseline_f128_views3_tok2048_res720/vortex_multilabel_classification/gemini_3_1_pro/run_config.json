{
  "run_id": "gemini31pro_multiframe_design_02_baseline_f128_views3_tok2048_res720",
  "task": "vortex_multilabel_classification",
  "model": "gemini_3_1_pro",
  "model_cfg": {
    "adapter": "gemini",
    "role": "vlm",
    "provider_model_id": "google/gemini-3.1-pro-preview",
    "api_style": "openai_compatible",
    "base_url_env": "OPENROUTER_BASE_URL",
    "api_key_env": "OPENROUTER_API_KEY",
    "media_transport": "data_uri",
    "temperature": 0,
    "max_completion_tokens": 2048,
    "timeout_s": 180
  },
  "data_list": "design_choices/artifacts/run_lists/selected_80.jsonl",
  "data_root": "data",
  "camera_views": [
    "front",
    "left",
    "right"
  ],
  "max_videos_per_sample": 0,
  "concurrency": 2,
  "schema_request": {
    "enabled": true,
    "provider_format": "json_schema",
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "name": "multilabel_classification",
        "strict": true,
        "schema": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "success",
                "failure"
              ]
            },
            "failure_modes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "cap_open",
                  "tube_drop",
                  "tube_empty",
                  "vortex_off",
                  "wrong_orientation",
                  "wrong_rack",
                  "rack_flipped",
                  "other_failure"
                ]
              },
              "description": "Empty iff success; ordered most-important first."
            },
            "confidence": {
              "type": "number"
            },
            "reasoning": {
              "type": "string"
            },
            "additional_failures": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "string"
                  }
                },
                "required": [
                  "description",
                  "evidence"
                ],
                "additionalProperties": false
              },
              "description": "Non-empty iff 'other_failure' is in failure_modes."
            }
          },
          "required": [
            "outcome",
            "failure_modes",
            "confidence",
            "reasoning",
            "additional_failures"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "defaults": {
    "media": {
      "input_type": "image_frames",
      "camera_views": [
        "front",
        "left",
        "right"
      ],
      "max_videos_per_sample": 0,
      "fairness_profile": "canonical_clip_1080px_30fps",
      "preprocess": {
        "transcode": {
          "enabled": true,
          "max_width": 1080,
          "fps": 30,
          "crf": 28,
          "preset": "veryfast"
        },
        "contact_sheet": {
          "max_width": 720,
          "fps": 1,
          "columns": 4,
          "rows": 8,
          "quality": 10
        },
        "frames": {
          "frame_count": 128,
          "max_width": 720,
          "quality": 10
        }
      }
    },
    "call": {
      "max_retries": 5,
      "timeout_seconds": 180,
      "max_completion_tokens": 2048
    }
  }
}
