{
  "name": "single_choice_multiclass_10_medium_reasoning_1080p30fps_minimax_retry1",
  "metadata_path": "metadata/real_human_samples_no_multiple.json",
  "output_root": "runs",
  "provider": "openrouter",
  "models": [
    "minimax/minimax-m3"
  ],
  "tasks": [
    "single_choice_multiclass"
  ],
  "sample_filter": {
    "task_ids": [],
    "include_sample_ids": [
      "real_human_carrie_00_success_success_01_clean",
      "real_human_carrie_02_tube_drop_fail_tube_drop_01",
      "real_human_carrie_03_tube_empty_fail_tube_empty_01",
      "real_human_carrie_06_wrong_rack_fail_wrong_rack_01",
      "real_human_carrie_07_rack_flipped_fail_rack_flipped_01"
    ],
    "exclude_sample_ids": []
  },
  "media": {
    "input_type": "video",
    "fairness_profile": "canonical_clip_1080px_30fps",
    "camera_views": [],
    "max_videos_per_sample": 0,
    "max_total_video_mb_per_request": 250,
    "preprocess": {
      "transcode": {
        "enabled": true,
        "max_width": 1080,
        "fps": 30,
        "crf": 28,
        "preset": "veryfast"
      }
    }
  },
  "openrouter": {
    "api_url": "https://openrouter.ai/api/v1/chat/completions",
    "api_key_env": "OPENROUTER_API_KEY",
    "temperature": 0,
    "max_completion_tokens": 1400,
    "timeout_seconds": 180,
    "metadata_enabled": true,
    "require_structured_output": false,
    "reasoning": {
      "max_tokens": 512,
      "exclude": true
    }
  }
}
