{
  "name": "single_choice_full_qwen3_vl_8b_official_contact_sheet",
  "metadata_path": "metadata/real_human_samples_no_multiple.json",
  "output_root": "runs",
  "provider": "openrouter",
  "models": [
    "qwen/qwen3-vl-8b-instruct"
  ],
  "tasks": [
    "single_choice_multiclass"
  ],
  "sample_filter": {
    "task_ids": [],
    "include_sample_ids": [],
    "exclude_sample_ids": []
  },
  "media": {
    "input_type": "image_contact_sheet",
    "fairness_profile": "contact_sheet_720px_1fps_4x8",
    "camera_views": [],
    "max_videos_per_sample": 0,
    "max_total_video_mb_per_request": 250,
    "preprocess": {
      "contact_sheet": {
        "enabled": true,
        "max_width": 720,
        "fps": 1,
        "columns": 4,
        "rows": 8,
        "quality": 3
      }
    }
  },
  "openrouter": {
    "api_url": "https://openrouter.ai/api/v1/chat/completions",
    "api_key_env": "OPENROUTER_API_KEY",
    "temperature": 0,
    "max_completion_tokens": 1800,
    "timeout_seconds": 180,
    "metadata_enabled": true,
    "require_structured_output": false
  }
}
