{
  "name": "single_choice_smoke_gpt_5_5_standard_contact_sheet",
  "metadata_path": "metadata/real_human_samples_no_multiple.json",
  "output_root": "runs",
  "provider": "openrouter",
  "models": [
    "openai/gpt-5.5"
  ],
  "tasks": [
    "single_choice_multiclass"
  ],
  "sample_filter": {
    "task_ids": [],
    "include_sample_ids": [
      "real_human_carrie_00_success_success_01_clean",
      "real_human_carrie_01_cap_open_fail_cap_loose_01",
      "real_human_carrie_02_tube_drop_fail_tube_drop_01",
      "real_human_carrie_04_vortex_off_fail_vortex_off_01",
      "real_human_carrie_07_rack_flipped_fail_rack_flipped_01"
    ],
    "exclude_sample_ids": []
  },
  "media": {
    "input_type": "image_contact_sheet",
    "fairness_profile": "contact_sheet_720px_1fps_4x8",
    "camera_views": [],
    "max_videos_per_sample": 0,
    "max_total_video_mb_per_request": 250,
    "preprocess": {
      "contact_sheet": {
        "enabled": true,
        "max_width": 720,
        "fps": 1,
        "columns": 4,
        "rows": 8,
        "quality": 3
      }
    }
  },
  "openrouter": {
    "api_url": "https://openrouter.ai/api/v1/chat/completions",
    "api_key_env": "OPENROUTER_API_KEY",
    "max_completion_tokens": 1400,
    "timeout_seconds": 180,
    "metadata_enabled": true,
    "require_structured_output": false
  }
}
