{
  "name": "multiclass_full_gemini_flash_1080p30fps",
  "metadata_path": "metadata/real_human_samples.json",
  "output_root": "runs",
  "provider": "openrouter",
  "models": [
    "google/gemini-3.5-flash"
  ],
  "tasks": [
    "failure_mode_classification"
  ],
  "sample_filter": {
    "task_ids": [],
    "include_sample_ids": [],
    "exclude_sample_ids": []
  },
  "media": {
    "input_type": "video",
    "fairness_profile": "canonical_clip_1080px_30fps",
    "camera_views": [],
    "max_videos_per_sample": 0,
    "max_total_video_mb_per_request": 250,
    "preprocess": {
      "transcode": {
        "enabled": true,
        "max_width": 1080,
        "fps": 30,
        "crf": 28,
        "preset": "veryfast"
      }
    }
  },
  "openrouter": {
    "api_url": "https://openrouter.ai/api/v1/chat/completions",
    "api_key_env": "OPENROUTER_API_KEY",
    "temperature": 0,
    "max_completion_tokens": 2000,
    "timeout_seconds": 180,
    "metadata_enabled": true,
    "require_structured_output": false,
    "reasoning": {
      "exclude": true
    }
  }
}
