{
  "name": "vortexing_openrouter_minimax_smoke",
  "metadata_path": "metadata/real_human_samples.json",
  "output_root": "runs",
  "provider": "openrouter",
  "models": [
    "minimax/minimax-m3"
  ],
  "tasks": [
    "binary_success",
    "failure_mode_classification"
  ],
  "sample_filter": {
    "task_ids": [
      "basic_vortexing"
    ],
    "include_sample_ids": [
      "real_human_carrie_00_success_success_01_clean",
      "real_human_carrie_02_tube_drop_fail_tube_drop_01"
    ],
    "exclude_sample_ids": []
  },
  "media": {
    "input_type": "video",
    "fairness_profile": "canonical_clip_720px_15fps",
    "camera_views": [],
    "max_videos_per_sample": 0,
    "max_total_video_mb_per_request": 250,
    "preprocess": {
      "transcode": {
        "enabled": true,
        "max_width": 720,
        "fps": 15,
        "crf": 28,
        "preset": "veryfast"
      }
    }
  },
  "openrouter": {
    "api_url": "https://openrouter.ai/api/v1/chat/completions",
    "api_key_env": "OPENROUTER_API_KEY",
    "temperature": 0,
    "max_completion_tokens": 700,
    "timeout_seconds": 180,
    "metadata_enabled": true,
    "require_structured_output": false,
    "reasoning": {
      "effort": "none",
      "exclude": true
    }
  }
}
