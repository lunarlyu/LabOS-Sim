# Data: ignore everything under data/ EXCEPT the small catalogs/run-lists.
# (Re-include directories first so the file negations can take effect.)
data/**
!data/**/
!data/**/metadata.jsonl
!data/**/source_metadata.json
!data/**/*run_list*.jsonl

# Generated evaluation run artifacts (keep eval/runs/processed/ trackable)
eval/runs/raw/
eval/runs/.media_cache/

# Regenerable preprocessed media.
eval/.cache/

# Local paper draft; publish separately when submission text is ready.
paper/icml_appendix_design_choices.md

# Secrets
.env
_env.json
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
.ipynb_checkpoints/

# SDT-IRT posteriors (large NetCDF)
*.nc
