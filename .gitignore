# Data: ignore everything under data/ EXCEPT the small catalogs/run-lists.
# (Re-include directories first so the file negations can take effect.)
data/**
!data/**/
!data/**/metadata.jsonl
!data/**/*run_list*.jsonl

# Generated run artifacts (raw predictions + media caches; keep runs/processed/ trackable)
runs/raw/
runs/.media_cache/

# Design-justification predictions and derived results are versioned; media is not.
design_justification/eval_design_choices/.media_cache/
design_justification/prompt_design_choice/pilot_n10_contact_sheets/runs/.media_cache/
design_justification/prompt_design_choice/screen_n80_independent_frames/runs/.media_cache/

# Local paper draft; publish separately when submission text is ready.
paper/icml_appendix_design_choices.md

# Secrets
.env
_env.json
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
.ipynb_checkpoints/

# SDT-IRT posteriors (large NetCDF)
*.nc
